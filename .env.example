# Copy to .env and fill in. Every key is optional; the app degrades instead of failing.

# Gemma via the Gemini API (https://aistudio.google.com/apikey). Without it, a weather-only rule decides.
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-31b-it

# Google Maps places via SerpApi (https://serpapi.com/manage-api-key). Without it, Gemma suggests places itself.
SERPAPI_KEY=

# Telegram alert on GO. Create a bot with @BotFather, message it once, then read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CHECK_EVERY_HOURS=12
PORT=3000
# Origin allowed to call the API from a separately hosted frontend, e.g. https://sloth.example.com. Default * (any).
CORS_ORIGIN=

# "Send itinerary" POSTs {to, subject, text, itinerary} as JSON here, e.g. your own mail relay or a
# Make/Zapier/n8n webhook that emails it. ITINERARY_API_KEY, if set, goes as "Authorization: Bearer <key>".
ITINERARY_API_URL=
ITINERARY_API_KEY=
